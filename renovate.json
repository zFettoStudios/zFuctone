{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "labels": ["dependencies"],
  "semanticCommitType": "build",
  "commitMessagePrefix": "chore(deps): ",
  "minimumReleaseAge": null,
  "ignoreUnstable": false,
  "ignorePrAuthor": true,
  "packageRules": [
    {
      "matchPackageNames": ["net.fabricmc:fabric-loader"],
      "registryUrls": ["https://maven.fabricmc.net/"]
    },
    {
      "matchPackageNames": ["io.papermc.paper:paper-api"],
      "registryUrls": ["https://repo.papermc.io/repository/maven-public/"]
    },
    {
      "matchPackageNames": ["org.spigotmc:spigot-api"],
      "registryUrls": ["https://hub.spigotmc.org/nexus/content/repositories/snapshots/"]
    },
    {
      "matchPackageNames": ["eu.pb4:placeholder-api", "maven.modrinth:vanish"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<prerelease>[^+]+))?\\+(?<compatibility>.+)$"
    }
  ]
}
